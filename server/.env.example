# Qingqiu World server configuration template.
#
# The server loads `.env` from its executable directory and then from the
# working directory. Copy this file to `server/.env` and uncomment what you
# need; an empty or missing value falls back to the default shown here.
# Invalid nonempty numeric values warn at startup and fall back to defaults.
# Related window and KB retrieval settings fall back as a group when their
# combined bounds are inconsistent.
#
# Electron injects PORT, DATA_ROOT, LOG_DIR, and the DEV_* variables itself,
# so a packaged installation does not need this file.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Root of all persistent data. Relative paths resolve against the server
# working directory. `~/` is expanded.
# DATA_ROOT=../data

# Directory for rotating log files.
# LOG_DIR=logs

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# HTTP listen port.
# PORT=8000

# DEBUG, INFO, WARN, or ERROR.
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Conversation context and summarization
# ---------------------------------------------------------------------------

# Messages accumulated before a summary is generated.
# SUMMARY_WINDOW_SIZE=50

# Token budget that triggers the fallback summary path.
# SUMMARY_TOKEN_THRESHOLD=16000

# Recent iterations visible to the agent and the point where the window
# is bulk-shrunk.
# MIN_ITERATION_WINDOW=10
# MAX_ITERATION_WINDOW=100
# Window bounds must satisfy 0 < MIN_ITERATION_WINDOW < MAX_ITERATION_WINDOW.

# Character budget for agent notes.
# NOTES_MAX_CHARS=10000

# Iteration cap for one focused work loop.
# FOCUSED_WORK_MAX_ITERATIONS=300

# ---------------------------------------------------------------------------
# Knowledge base
# ---------------------------------------------------------------------------

# Vector count below which exact search is used instead of an HNSW index.
# KB_FLAT_THRESHOLD=1000

# Retrieval unit token bounds and overlap when splitting oversized leaves.
# KB_RETRIEVAL_MIN_TOKENS=64
# KB_RETRIEVAL_MAX_TOKENS=512
# KB_CHUNK_OVERLAP_TOKENS=64

# Guard for embedding provider input length.
# KB_EMBEDDING_HARD_MAX_TOKENS=8192
# The retrieval minimum must be below the maximum; overlap may be zero but
# must be below the maximum, which must not exceed the embedding guard.

# ---------------------------------------------------------------------------
# Background cognition
# ---------------------------------------------------------------------------

# Minimum interval between daily-memory shard opportunities (1000-60000 ms;
# out-of-range values fall back to the default).
# DAILY_MEMORY_REQUEST_INTERVAL_MS=5000

# Model requests allowed for one background cognitive process (minimum 3).
# COGNITIVE_MAX_REQUESTS=12

# Age below which revisiting a topic needs explicit confirmation.
# COGNITIVE_RECENT_REVIEW_HOURS=24

# Minimum daily similarity for system-routed reviews (1-100 percent).
# COGNITIVE_ROUTE_MIN_SIMILARITY_PERCENT=35

# ---------------------------------------------------------------------------
# Developer data lifecycle
# ---------------------------------------------------------------------------
# Never enable these in a user installation. The two development launchers
# (server/start.sh and the Electron dev build) set the first two for you; they
# are listed only for starting the server directly without a launcher.

# DEV_DATA_MODE=1
# DEV_REPO_ROOT=/absolute/path/to/checkout

# Optional verified released-data backup for the very first baseline. It is
# ignored once baseline/<release> exists.
# DEV_BASELINE_SOURCE=/absolute/path/to/released-backup

# Internal signal used when this package runs a release binary against a staged
# copy. Do not set it manually.
# RELEASE_MIGRATION_ONLY=1
